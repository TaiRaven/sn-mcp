SN_INSTANCE=https://dev203275.service-now.com
SN_USER=claude_mcp_readonly
SN_PASS=

# Only used by `npm run start:http` (the remote-reachable transport) — ignored by the default stdio server.
# MCP_HTTP_HOST/PORT default to 127.0.0.1:3535 if unset. Set MCP_HTTP_TOKEN before exposing this beyond
# localhost — requests must then send `Authorization: Bearer <MCP_HTTP_TOKEN>`.
MCP_HTTP_HOST=
MCP_HTTP_PORT=
MCP_HTTP_TOKEN=
